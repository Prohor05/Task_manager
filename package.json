{
  "name": "aurora-tasks",
  "version": "1.0.0",
  "description": "Advanced Task Manager and Project Roadmap",
  "main": "electron/main.js",
  "author": "Aurora Tasks",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win nsis",
    "dist:dir": "vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.aurora.tasks",
    "productName": "Aurora Tasks",
    "directories": { "output": "dist-electron" },
    "files": ["electron/**/*", "dist/**/*", "package.json"],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
